# Copy locally to .env; never commit .env.
# No real values are provided in this PUBLIC repository.

# Model adapter (configure when code is implemented)
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Hashed credentials and session signing secret (NOT plain passwords)
ADMIN_PASSWORD_HASH=
TEST_PASSWORD_HASH=
SESSION_SECRET=

# Demo limits (provisional configuration targets)
MAX_IMAGES_PER_SESSION=40
SESSION_TTL_MINUTES=120
MAX_UPLOAD_MB=10
BATCH_PARALLELISM=3
PROVIDER_RETRIES=2
LIVE_CALLS_PER_SESSION=100
LIVE_CALLS_GLOBAL=250
IMAGE_MAX_EDGE=2200
IMAGE_JPEG_QUALITY=90
